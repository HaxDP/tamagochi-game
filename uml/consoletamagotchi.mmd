namespace Global {
  class Program
}

namespace ConsoleTamagotchi.Domain.Enums {
  class PetStage {
    <<enumeration>>
    Egg
    Baby
    Teen
    Adult
  }
  class PetAnimationState {
    <<enumeration>>
    Idle
    Sleeping
    Eating
  }
  class PetSpecies {
    <<enumeration>>
    Cat
    Dog
  }
}

namespace ConsoleTamagotchi.Domain.ValueObjects {
  class Vector2 {
    <<record struct>>
    +double X
    +double Y
  }
}

namespace ConsoleTamagotchi.Domain.Models {
  class PetNeeds {
    +double Hunger
    +double Happiness
    +double Energy
    +double Hygiene
    +double Health
    +Set(hunger, happiness, energy, hygiene, health)
    +ChangeHunger(delta)
    +ChangeHappiness(delta)
    +ChangeEnergy(delta)
    +ChangeHygiene(delta)
    +ChangeHealth(delta)
  }

  class Pet {
    +string Name
    +PetSpecies Species
    +PetStage Stage
    +PetAnimationState AnimationState
    +PetNeeds Needs
    +Vector2 Position
    +Vector2 Velocity
    +bool IsSleeping
    +bool IsDead
    +double AgeSeconds
    +double StageTimeSeconds
    +double ActionTimeRemaining
    +string StatusMessage
    +CreateNew(name, species, startPosition) Pet
    +Restore(state) Pet
    +ToState() PetState
    +AddAge(deltaSeconds)
    +ChangeStage(stage, message)
    +SetSleeping(value)
    +StartAction(state, durationSeconds, message)
    +MarkDead()
    +SetPosition(position)
    +SetVelocity(velocity)
    +SetStatusMessage(message)
  }

  class GameSettings {
    <<record>>
    +double GrowthRate
    +double StatDecayRate
    +Default
  }

  class WorldParticle {
    <<record struct>>
    +Vector2 Position
    +double TimeToLive
    +char Symbol
  }

  class GameWorldState {
    <<record>>
    +List~Vector2~ Poops
    +List~WorldParticle~ Particles
    +double NextPoopSpawnIn
    +double NextParticleSpawnIn
  }

  class PetState {
    <<record>>
    +string Name
    +PetSpecies Species
    +PetStage Stage
    +PetAnimationState AnimationState
    +bool IsSleeping
    +bool IsDead
    +double AgeSeconds
    +double StageTimeSeconds
    +double ActionTimeRemaining
    +string StatusMessage
    +Vector2 Position
    +Vector2 Velocity
    +double Hunger
    +double Happiness
    +double Energy
    +double Hygiene
    +double Health
  }

  class GameWorld {
    -List~Vector2~ _poops
    -List~WorldParticle~ _particles
    +IReadOnlyList~Vector2~ Poops
    +IReadOnlyList~WorldParticle~ Particles
    +double NextPoopSpawnIn
    +double NextParticleSpawnIn
    +Restore(state) GameWorld
    +ToState() GameWorldState
    +Tick(deltaSeconds)
    +TrySpawnPoop(random, worldWidth, worldHeight)
    +TrySpawnHappyParticles(pet, random)
    +ClearPoops()
    +TryCleanPoopAt(worldX, worldY) bool
  }
}

namespace ConsoleTamagotchi.Application.Models {
  class GameState {
    <<record>>
    +PetState Pet
    +GameWorldState World
    +GameSettings Settings
    +double ElapsedSeconds
  }
}

namespace ConsoleTamagotchi.Application.Interfaces {
  class IPetInteractionService {
    <<interface>>
    +Feed(pet, world)
    +Play(pet, world)
    +Clean(pet, world)
    +Sleep(pet, world)
    +Heal(pet, world)
  }

  class IPetSimulationService {
    <<interface>>
    +Update(pet, world, settings, deltaSeconds, worldWidth, worldHeight)
  }

  class IGameStateStore {
    <<interface>>
    +Exists() bool
    +Load() GameState
    +Save(state)
    +Delete()
  }
}

namespace ConsoleTamagotchi.Application.Services {
  class PetInteractionService
  class PetSimulationService {
    -IRandomProvider _random
    -double _directionChangeCooldown
    +PetSimulationService(random)
    +Update(pet, world, settings, deltaSeconds, worldWidth, worldHeight)
  }
}

